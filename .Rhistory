if (!require(GGally)) {
install.packages("GGally")
library(GGally)
}
if (!require(ggplot2)) {
install.packages("ggplot2")
library(ggplot2)
}
if (!require(dplyr)) {
install.packages("dplyr")
library(dplyr)
}
# Load the trees dataset
data(trees)
# View data structure
str(trees)
summary(trees)
# Generate scatterplot array with correlations
ggpairs(trees,
title = "Scatterplot Array of Trees Dataset",
lower = list(continuous = wrap("points", alpha = 0.6, size = 2)),
diag = list(continuous = wrap("barDiag", bins = 10)))
# Fit the multiple linear regression model
model_mlr <- lm(Volume ~ Girth + Height, data = trees)
summary(model_mlr)
# Extract coefficients
beta0 <- coef(model_mlr)[1]
beta1 <- coef(model_mlr)[2]
beta2 <- coef(model_mlr)[3]
# Fit model with interaction term
model_interaction <- lm(Volume ~ Girth + Height + Girth:Height, data = trees)
summary(model_interaction)
# Compare the two models
cat("Model without interaction - Adjusted R²:",
round(summary(model_mlr)$adj.r.squared, 4), "\n")
cat("Model with interaction - Adjusted R²:",
round(summary(model_interaction)$adj.r.squared, 4), "\n\n")
cat("Model without interaction - AIC:", round(AIC(model_mlr), 2), "\n")
cat("Model with interaction - AIC:", round(AIC(model_interaction), 2), "\n\n")
# F-test for nested models
cat("ANOVA comparison of nested models:\n")
anova(model_mlr, model_interaction)
# Create residual plots for model without interaction
par(mfrow = c(2, 2))
plot(model_mlr, main = "Model without Interaction")
# Create residual plots for model with interaction
par(mfrow = c(2, 2))
plot(model_interaction, main = "Model with Interaction")
# Additional diagnostic comparison
par(mfrow = c(1, 2))
# Residuals vs Fitted for both models
plot(fitted(model_mlr), resid(model_mlr),
main = "Residuals vs Fitted (No Interaction)",
xlab = "Fitted Values", ylab = "Residuals",
pch = 19, col = "#2E86AB")
abline(h = 0, col = "#E63946", lwd = 2, lty = 2)
plot(fitted(model_interaction), resid(model_interaction),
main = "Residuals vs Fitted (With Interaction)",
xlab = "Fitted Values", ylab = "Residuals",
pch = 19, col = "#A23B72")
abline(h = 0, col = "#E63946", lwd = 2, lty = 2)
# Select the recommended model based on interaction term significance
if (summary(model_interaction)$coefficients[4,4] < 0.05) {
recommended_model <- model_interaction
cat("Using model with interaction term\n\n")
} else {
recommended_model <- model_mlr
cat("Using model without interaction term\n\n")
}
# Create new data for prediction
new_tree <- data.frame(Girth = 18, Height = 70)
# Generate prediction interval
pred_interval <- predict(recommended_model, newdata = new_tree,
interval = "prediction", level = 0.95)
print(pred_interval)
