levene_result <- leveneTest(stations ~ depth_interval, data = quakes)
cat("\nLevene's Test (robust to non-normality):\n")
print(levene_result)
Best choice for Equal Variances test:
if (levene_result$`Pr(>F)`[1] < 0.05) {
cat("Result: REJECT equal variances assumption (p < 0.05)\n")
} else {
cat("Result: FAIL TO REJECT equal variances assumption (p >= 0.05)\n")
}
# Problem 1c.
Based on the assumption checks:
Recommendation: Use Kruskal-Wallis test if any assumptions are violated, as it is more robust and does not require normality or equal variances.
# Problem 1d.
kruskal_result <- kruskal.test(stations ~ depth_interval, data = quakes)
print(kruskal_result)
if (kruskal_result$p.value < 0.05) {
cat(sprintf("p-value (%.4e) < 0.05: REJECT the null hypothesis\n", kruskal_result$p.value))
cat("Conclusion: There IS a significant difference in the number of reporting\n")
cat("stations across the three depth intervals.\n")
} else {
cat(sprintf("p-value (%.4f) >= 0.05: FAIL TO REJECT the null hypothesis\n", kruskal_result$p.value))
cat("Conclusion: There is NO significant difference in the number of reporting\n")
cat("stations across the three depth intervals.\n")
}
# Problem 1e.
anova_result <- aov(stations ~ depth_interval, data = quakes)
anova_summary <- summary(anova_result)
print(anova_summary)
p_value_anova <- anova_summary[[1]]$`Pr(>F)`[1]
if (p_value_anova < 0.05) {
cat(sprintf("p-value (%.4e) < 0.05: REJECT the null hypothesis\n", p_value_anova))
cat("Conclusion: There IS a significant difference in the number of reporting\n")
cat("stations across the three depth intervals.\n")
} else {
cat(sprintf("p-value (%.4f) >= 0.05: FAIL TO REJECT the null hypothesis\n", p_value_anova))
cat("Conclusion: There is NO significant difference in the number of reporting\n")
cat("stations across the three depth intervals.\n")
}
Do both tests reach the same conclusion? Compare the p-values and conclusions from both Kruskal-Wallis and One-Way ANOVA tests.
# Problem 1f.
If assumptions were met, use Tukey's HSD (more conservative). If ANOVA was conducted despite assumption violations, Fisher's LSD may be used.
# Tukey's HSD
tukey_result <- TukeyHSD(anova_result)
print(tukey_result)
pairwise_result <- pairwise.wilcox.test(quakes$stations,
quakes$depth_interval,
p.adjust.method = "bonferroni")
print(pairwise_result)
Look at the adjusted p-values for each pairwise comparison. Pairs with p < 0.05 show significant differences. Identify which depth interval has significantly different (higher or lower) numbers of reporting stations compared to the others.
print(summary_stats[, c("depth_interval", "mean", "median")])
print(summary_stats[, c("depth_interval", "mean", "median")])
print(summary_stats[, c("depth_interval", "mean", "median")])
knitr::opts_chunk$set(echo = TRUE)
if (!require(ggplot2)) {
install.packages("ggplot2")
library(ggplot2)
}
if (!require(dplyr)) {
install.packages("dplyr")
library(dplyr)
}
if (!require(car)) {
install.packages("car")
library(car)
}
# Load the quakes dataset
data(quakes)
# View data structure
str(quakes)
summary(quakes)
# Create depth intervals using cut() function
quakes$depth_interval <- cut(quakes$depth,
breaks = c(0, 200, 400, 700),
labels = c("(0, 200]", "(200, 400]", "(400, 700]"),
include.lowest = TRUE)
# Check the depth intervals
table(quakes$depth_interval)
# Create boxplot comparing stations by depth intervals
p1a <- ggplot(quakes, aes(x = depth_interval, y = stations, fill = depth_interval)) +
geom_boxplot(alpha = 0.7, outlier.shape = NA) +
geom_jitter(width = 0.2, size = 2, alpha = 0.5) +
scale_fill_brewer(palette = "Set2") +
labs(title = "Number of Reporting Stations by Depth Interval",
x = "Depth Interval (km)",
y = "Number of Stations") +
theme_minimal() +
theme(legend.position = "none",
plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
axis.title = element_text(face = "bold"))
print(p1a)
# Summary statistics by group
summary_stats <- quakes %>%
group_by(depth_interval) %>%
summarise(
n = n(),
mean = mean(stations),
median = median(stations),
sd = sd(stations),
min = min(stations),
max = max(stations)
)
print(summary_stats)
depth_levels <- levels(quakes$depth_interval)
shapiro_results <- data.frame(
Depth_Interval = character(),
W_Statistic = numeric(),
P_Value = numeric(),
Result = character(),
stringsAsFactors = FALSE
)
for (depth in depth_levels) {
subset_data <- quakes$stations[quakes$depth_interval == depth]
shapiro_result <- shapiro.test(subset_data)
result_text <- ifelse(shapiro_result$p.value >= 0.05, "Normal", "Not Normal")
shapiro_results <- rbind(shapiro_results, data.frame(
Depth_Interval = depth,
W_Statistic = round(shapiro_result$statistic, 4),
P_Value = shapiro_result$p.value,
Result = result_text
))
}
print(shapiro_results)
# QQ Plots for visual assessment
par(mfrow = c(1, 3), mar = c(4, 4, 2, 1))
for (depth in depth_levels) {
subset_data <- quakes$stations[quakes$depth_interval == depth]
qqnorm(subset_data, main = paste("QQ Plot:", depth))
qqline(subset_data, col = "red")
}
par(mfrow = c(1, 1))
levene_result <- leveneTest(stations ~ depth_interval, data = quakes)
print(levene_result)
kruskal_result <- kruskal.test(stations ~ depth_interval, data = quakes)
print(kruskal_result)
anova_result <- aov(stations ~ depth_interval, data = quakes)
anova_summary <- summary(anova_result)
print(anova_summary)
p_val_anova <- anova_summary[[1]]$'Pr(>F)'[1]
p_val_kruskal <- kruskal_result$p.value
same_conclusion <- (p_val_anova < 0.05) == (p_val_kruskal < 0.05)
# Tukey's HSD (parametric post-hoc)
tukey_result <- TukeyHSD(anova_result)
print(tukey_result)
# Pairwise Wilcoxon test with Bonferroni correction (non-parametric post-hoc)
pairwise_result <- pairwise.wilcox.test(quakes$stations,
quakes$depth_interval,
p.adjust.method = "bonferroni")
print(pairwise_result)
print(summary_stats[, c("depth_interval", "mean", "median")])
best_depth <- summary_stats$depth_interval[which.max(summary_stats$mean)]
best_mean <- max(summary_stats$mean)
knitr::opts_chunk$set(echo = TRUE)
if (!require(ggplot2)) {
install.packages("ggplot2")
library(ggplot2)
}
if (!require(dplyr)) {
install.packages("dplyr")
library(dplyr)
}
# Load the cars dataset
data(cars)
# View data structure
str(cars)
summary(cars)
# Create scatterplot of speed vs stopping distance
p1a <- ggplot(cars, aes(x = speed, y = dist)) +
geom_point(color = "#2E86AB", size = 3, shape = 16, alpha = 0.7) +
labs(title = "Relationship Between Speed and Stopping Distance",
subtitle = "Cars from the 1920s",
x = "Speed (mph)",
y = "Stopping Distance (ft)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.title = element_text(face = "bold"))
print(p1a)
# Calculate Pearson's correlation coefficient
cor_speed_dist <- cor(cars$speed, cars$dist)
print(paste("Pearson's Correlation Coefficient:", round(cor_speed_dist, 4)))
# Perform correlation test
cor_test <- cor.test(cars$speed, cars$dist)
print(cor_test)
# Fit simple linear regression model
model_cars <- lm(dist ~ speed, data = cars)
summary(model_cars)
# Extract coefficients
beta0 <- coef(model_cars)[1]
beta1 <- coef(model_cars)[2]
# Add fitted line to scatterplot
p1d <- ggplot(cars, aes(x = speed, y = dist)) +
geom_point(color = "#2E86AB", size = 3, shape = 16, alpha = 0.7) +
geom_smooth(method = "lm", se = FALSE, color = "#E63946", linewidth = 1.2) +
labs(title = "Relationship Between Speed and Stopping Distance",
subtitle = "With Fitted Linear Regression Line",
x = "Speed (mph)",
y = "Stopping Distance (ft)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.title = element_text(face = "bold"))
print(p1d)
# Generate prediction interval for 30 mph
new_data <- data.frame(speed = 30)
pred_30 <- predict(model_cars, newdata = new_data, interval = "prediction", level = 0.95)
print(pred_30)
# Add shaded prediction interval to scatterplot
p1f <- ggplot(cars, aes(x = speed, y = dist)) +
geom_point(color = "#2E86AB", size = 3, shape = 16, alpha = 0.7) +
geom_smooth(method = "lm", se = TRUE, color = "#E63946", fill = "#FFB4A2",
linewidth = 1.2, alpha = 0.3, level = 0.95) +
geom_vline(xintercept = 30, linetype = "dashed", color = "darkgreen", alpha = 0.6) +
annotate("text", x = 30, y = max(cars$dist) * 0.95,
label = "30 mph", color = "darkgreen", hjust = -0.2, fontface = "bold") +
labs(title = "Speed vs Stopping Distance with 95% Prediction Interval",
subtitle = "Dashed line indicates 30 mph prediction point",
x = "Speed (mph)",
y = "Stopping Distance (ft)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.title = element_text(face = "bold"))
print(p1f)
# Load the faithful dataset
data(faithful)
# View data structure
str(faithful)
summary(faithful)
# Create scatterplot of eruptions vs waiting time
p2a <- ggplot(faithful, aes(x = eruptions, y = waiting)) +
geom_point(color = "#A23B72", size = 2.5, shape = 17, alpha = 0.6) +
labs(title = "Relationship Between Eruption Duration and Waiting Time",
subtitle = "Old Faithful Geyser, Yellowstone National Park",
x = "Eruption Duration (minutes)",
y = "Waiting Time to Next Eruption (minutes)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.title = element_text(face = "bold"))
print(p2a)
# Calculate Pearson's correlation coefficient
cor_erupt_wait <- cor(faithful$eruptions, faithful$waiting)
print(paste("Pearson's Correlation Coefficient:", round(cor_erupt_wait, 4)))
# Perform correlation test
cor_test_faithful <- cor.test(faithful$eruptions, faithful$waiting)
print(cor_test_faithful)
# Fit simple linear regression model
model_faithful <- lm(waiting ~ eruptions, data = faithful)
summary(model_faithful)
# Extract coefficients
beta0_faithful <- coef(model_faithful)[1]
beta1_faithful <- coef(model_faithful)[2]
# Add fitted line to scatterplot
p2d <- ggplot(faithful, aes(x = eruptions, y = waiting)) +
geom_point(color = "#A23B72", size = 2.5, shape = 17, alpha = 0.6) +
geom_smooth(method = "lm", se = FALSE, color = "#F18F01", linewidth = 1.2) +
labs(title = "Eruption Duration vs Waiting Time",
subtitle = "With Fitted Linear Regression Line",
x = "Eruption Duration (minutes)",
y = "Waiting Time to Next Eruption (minutes)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.title = element_text(face = "bold"))
print(p2d)
# Generate prediction interval for 6 minutes eruption
new_data_faithful <- data.frame(eruptions = 6)
pred_6min <- predict(model_faithful, newdata = new_data_faithful,
interval = "prediction", level = 0.99)
print(pred_6min)
# Add shaded prediction interval to scatterplot
p2f <- ggplot(faithful, aes(x = eruptions, y = waiting)) +
geom_point(color = "#A23B72", size = 2.5, shape = 17, alpha = 0.6) +
geom_smooth(method = "lm", se = TRUE, color = "#F18F01", fill = "#FFDB58",
linewidth = 1.2, alpha = 0.3, level = 0.99) +
geom_vline(xintercept = 6, linetype = "dashed", color = "darkred", alpha = 0.7) +
annotate("text", x = 6, y = min(faithful$waiting) + 5,
label = "6 min (extrapolation)", color = "darkred", hjust = -0.1,
fontface = "bold", size = 3.5) +
labs(title = "Eruption Duration vs Waiting Time with 99% Prediction Interval",
subtitle = "Dashed line indicates 6-minute prediction point (beyond data range)",
x = "Eruption Duration (minutes)",
y = "Waiting Time to Next Eruption (minutes)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.title = element_text(face = "bold"))
print(p2f)
